{
  "name": "api-recepcao",
  "version": "1.0.0",
  "description": "api to manager visits into prefeitura",
  "keywords": [
    "api",
    "management",
    "fastify",
    "sequelize"
  ],
  "license": "MIT",
  "author": "Kadoia614",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p .",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "start": "node dist/server.js",
    "prestart": "npm install --production",
    "migrate:generate": "npx ts-node src/core/utils/generateMigration.ts",
    "migrate": "npm run build && npx sequelize-cli db:migrate",
    "migrate:undo": "npm run build && npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npm run build && npx sequelize-cli db:migrate:undo:all",
    "seed": "npm run build && npx sequelize-cli db:seed:all",
    "seed:undo": "npm run build && npx sequelize-cli db:seed:undo",
    "seed:undo:all": "npm run build && npx sequelize-cli db:seed:undo:all"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "bcryptjs": "^3.0.2",
    "cpf-cnpj-validator": "^1.0.3",
    "dotenv": "^17.0.1",
    "fastify": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "mariadb": "^3.4.4",
    "moment": "^2.30.1",
    "nodemailer": "^7.0.5",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^6.4.17",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
